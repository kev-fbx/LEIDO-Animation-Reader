{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "MSVC x64 (Qt from tools/qt, deps from tools/vcpkg)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "${sourceDir}/../tools/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "${sourceDir}/../tools/qt/6.10.3/msvc2022_64",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/../tools/vcpkg_installed"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "default", "configuration": "Debug" },
    { "name": "release", "configurePreset": "default", "configuration": "Release" }
  ]
}
